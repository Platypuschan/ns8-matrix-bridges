import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import bridge_runtime
import bridge_setup

info = bridge_setup.bridge_info()
json.dump(
    bridge_setup.configuration(info, bridge_setup.read_settings(), bridge_runtime.read_state()),
    fp=sys.stdout,
)
