# Store the settings and connect the bridge to the homeserver module of
# this node (see bridge_runtime.sync).

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import bridge_runtime
import bridge_setup

data = json.load(sys.stdin)
info = bridge_setup.bridge_info()


def fail(field, value, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(2)


with bridge_setup.settings_lock():
    try:
        bridge_setup.apply_request(data, info, write=False)
    except bridge_setup.SettingsError as error:
        fail(error.field, error.value, error.error)
    settings = bridge_setup.apply_request(data, info)
    try:
        bridge_runtime.sync(info, settings, int(os.environ["TCP_PORT"]))
    except bridge_runtime.BridgeError as error:
        print(error, file=sys.stderr)
        fail("matrix_module", "", error.error)
